# Angular Frontend environment variables (provided by container runtime)
# Do NOT commit real secrets; this file is only an example.

# Base URL for backend REST API
NG_APP_BACKEND_URL=http://localhost:3001

# Base URL for realtime (future; SignalR/WebSocket)
NG_APP_WS_URL=

# Frontend URL (future use; OAuth redirects, etc.)
NG_APP_FRONTEND_URL=http://localhost:3000

# Environment
NG_APP_NODE_ENV=development
